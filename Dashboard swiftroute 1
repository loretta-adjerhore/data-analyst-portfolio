  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --gold: #C19A5B; --dark: #1A1A1A; --mid: #444444; --soft: #777777; --bg: #F8F6F2; --bg-card: #FFFFFF; --border: #E8E4DC; --header-bg: #1E1E1E; }
    body { font-family: "Source Sans 3", sans-serif; background: var(--header-bg); color: var(--dark); min-height: 100vh; display: flex; flex-direction: column; }
    .top-bar { background: var(--header-bg); padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #333; flex-shrink: 0; }
    .top-bar .brand { font-family: "Playfair Display", serif; color: #fff; font-size: 1rem; text-decoration: none; }
    .top-bar .back { color: #aaa; font-size: 0.82rem; text-decoration: none; letter-spacing: 0.08em; text-transform: uppercase; transition: color 0.2s; display: flex; align-items: center; gap: 7px; }
    .top-bar .back:hover { color: var(--gold); }
    .dash-header { background: #111; padding: 18px 32px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; flex-shrink: 0; }
    .dash-title { font-family: "Playfair Display", serif; color: #fff; font-size: 1.1rem; }
    .dash-meta { display: flex; align-items: center; gap: 16px; }
    .dash-tag { background: var(--gold); color: #fff; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 4px 12px; border-radius: 3px; }
    .dash-counter { color: #888; font-size: 0.82rem; }
    .dots { display: flex; gap: 6px; align-items: center; }
    .dot { width: 7px; height: 7px; border-radius: 50%; background: #444; transition: background 0.2s; }
    .dot.active { background: var(--gold); }
    .image-wrap { flex: 1; display: flex; align-items: center; justify-content: center; padding: 0; overflow: auto; }
    .image-wrap img { max-width: 100%; max-height: calc(100vh - 200px); object-fit: contain; display: block; }
    .bottom-nav { background: #111; padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #333; flex-shrink: 0; }
    .nav-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; border-radius: 3px; text-decoration: none; border: 2px solid #444; color: #ccc; transition: all 0.2s; }
    .nav-btn:hover { border-color: var(--gold); color: var(--gold); }
    .nav-btn.next { background: var(--gold); border-color: var(--gold); color: #fff; }
    .nav-btn.next:hover { background: #a8823e; border-color: #a8823e; }
    .nav-btn.disabled { opacity: 0.3; cursor: default; pointer-events: none; }
    .view-case { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; border-radius: 3px; text-decoration: none; border: 2px solid #555; color: #aaa; transition: all 0.2s; }
    .view-case:hover { border-color: #aaa; color: #fff; }
  </style>
</head>
<body>
  <div class="top-bar">
    <a href="index.html" class="brand">Loretta Adjerhore</a>
    <a href="project-logistics.html#dashboards" class="back"><i class="fas fa-arrow-left"></i> Back to SwiftRoute Logistics</a>
  </div>

  <div class="dash-header">
    <div>
      <div class="dash-title">SwiftRoute Logistics &mdash; Operations Performance</div>
    </div>
    <div class="dash-meta">
      <span class="dash-tag">Power BI</span>
      <span class="dash-counter">1 of 2</span>
      <div class="dots"><span class="dot active"></span><span class="dot"></span></div>
    </div>
  </div>

  <div class="image-wrap">
    <img src="images/swiftroute-operations.JPG" alt="Operations Performance" />
  </div>

  <div class="bottom-nav">
    <span class="nav-btn disabled"><i class="fas fa-arrow-left"></i> First Dashboard</span>
    <a href="project-logistics.html" class="view-case"><i class="fas fa-file-alt"></i> View Case Study</a>
    <a href="dashboard-swiftroute-2.html" class="nav-btn next">Customer Service <i class="fas fa-arrow-right"></i></a>
  </div>
</body>
</html>
